# ── Email account (for fetch_threads.py) ─────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=you@yourworkspace.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ── Lead pipeline API keys ────────────────────────────────────────────────────
# GitHub personal access token (free — create at github.com/settings/tokens)
# Scopes needed: read:user, user:email
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Crunchbase Basic API key (free — register at data.crunchbase.com)
CRUNCHBASE_KEY=

# Hunter.io API key (free tier: 25 searches/month — hunter.io)
HUNTER_KEY=

# Apollo.io API key (free tier: 50 exports/month — app.apollo.io/settings/integrations/api)
APOLLO_KEY=

# Verifalia (optional, for premium email verification)
VERIFALIA_SID=
VERIFALIA_KEY=
